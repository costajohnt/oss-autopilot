{
  "name": "oss-autopilot",
  "version": "0.34.1",
  "description": "AI-powered autopilot for managing open source contributions with Claude Code",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "oss-autopilot": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "bundle": "esbuild src/cli.ts --bundle --platform=node --target=node18 --format=cjs --outfile=dist/cli.bundle.cjs",
    "start": "tsx src/cli.ts",
    "dev": "tsx watch src/cli.ts",
    "daily": "tsx src/cli.ts daily",
    "search": "tsx src/cli.ts search",
    "status": "tsx src/cli.ts status",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm test && npm run build && npm run bundle"
  },
  "keywords": [
    "claude-code-plugin",
    "open-source",
    "github",
    "contributions",
    "ai-agent",
    "cli"
  ],
  "author": "John Costa",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/costajohnt/oss-autopilot.git"
  },
  "homepage": "https://github.com/costajohnt/oss-autopilot#readme",
  "bugs": {
    "url": "https://github.com/costajohnt/oss-autopilot/issues"
  },
  "files": [
    ".claude-plugin/",
    "agents/",
    "commands/",
    "hooks/",
    "skills/",
    "dist/",
    "src/",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "esbuild": "^0.27.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "@octokit/plugin-throttling": "^11.0.3",
    "@octokit/rest": "^22.0.1",
    "commander": "^14.0.3"
  }
}
