{
  "name": "@oss-autopilot/video",
  "version": "0.1.0",
  "private": true,
  "description": "Marketing video for OSS Autopilot 1.0 (Remotion)",
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts OSSAutopilot1080p out/OSSAutopilot1080p.mp4",
    "render:square": "remotion render src/index.ts OSSAutopilotSquare out/OSSAutopilotSquare.mp4",
    "render:all": "npm run render && npm run render:square",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/transitions": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@remotion/eslint-config": "^4.0.0",
    "@types/react": "^18.3.12",
    "typescript": "^5.9.3"
  }
}
